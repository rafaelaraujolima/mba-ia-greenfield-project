# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Object Storage (MinIO for local development)
STORAGE_ENDPOINT=http://minio:9000
# Browser-reachable origin used only for presigning read URLs (stream/download/thumbnail).
# Deliberate exception to the "never use localhost" rule: this must be reachable from the
# browser, not from other containers.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=streamtube
STORAGE_ACCESS_KEY=streamtube
STORAGE_SECRET_KEY=streamtube123
STORAGE_REGION=us-east-1

# Queue (Redis / BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Video upload/processing lifecycle
VIDEO_DRAFT_TTL_HOURS=24
MULTIPART_LIFECYCLE_DAYS=1
